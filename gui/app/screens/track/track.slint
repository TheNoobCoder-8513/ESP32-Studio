import { Panel, HL, Check-Button, VL } from "../../widget.slint";
import { Theme } from "../../../theme.slint";
import { Chart } from "chart.slint";
import {
    Track-Pin,
    Track-Pin-Selector,
    Chart-Pin-Selector,
} from "tracker.slint";
import { State } from "../../../state.slint";

export component Track inherits HL {
    property <[Track-Pin]> tracked-pins;
    pure callback toggle-track-pin(int);

    padding: 0px;
    spacing: Theme.gap-s.norm;

    Track-Pin-Selector {
        toggle-track-pin(pin) => { root.toggle-track-pin(pin); }
    }

    if tracked-pins.length == 0: Panel { 
        // Make an empty state component here
    }

    if tracked-pins.length > 0: HL {
        property <int> active-chart;

        padding: 0px;

        Chart-Pin-Selector {
            tracked-pins: root.tracked-pins;
            active-chart <=> parent.active-chart;
        }

        VL {
            padding: 0px;
            Panel {
                HL {
                    padding: Theme.gap-s.norm;
                    Text {
                        text: "Timeline";
                        font-size: Theme.font-s.mid;
                        color: Theme.fg-c.page;
                        font-weight: 900;
                    }
                }
            }

            Chart {
                series: root.tracked-pins[active-chart].data;
            }
        }
    }
}
