import { Panel, VL, HL, Check-Button } from "../../widget.slint";
import { Theme } from "../../../theme.slint";
export struct Pin-Track-Def { labels: [string], gpio: int, enabled: bool, active: bool }


export component Track-Val inherits Panel {
    callback clicked();
    in property <string> label;
    in property <string> value;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        Text {
            text: root.label;
            font-size: Theme.font-s.mid;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Theme.fg-c.surface;
            overflow: elide;
        }

        Text {
            text: root.value;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Theme.font-s.mid;
            color: Theme.fg-c.surface;
            overflow: elide;
        }
    }
}

export component Track-Item inherits Panel {
    callback track();
    callback untrack();

    in property <string> title;
    in property <bool> status;

    HL {
        cross-axis-alignment: center;
        padding-left: Theme.gap-s.norm;
        padding-right: self.padding-left;

        Text {
            text: root.title;
            font-size: Theme.font-s.mid;
            color: Theme.fg-c.surface;
            overflow: elide;
        }

        Check-Button {
            selected: root.status;
            toggled => {
                if self.selected {
                    root.track();
                } else {
                    root.untrack();
                }
            }
        }
    }
}


export component Track-List {
    callback track-pin(string);
    callback untrack-pin(string);

    in-out property <[Pin-Track-Def]> pins;

    width: 200px;

    Flickable {

        VerticalLayout {
            alignment: start;
            spacing: Theme.gap-s.base;

            Panel {
                HL {
                    padding: Theme.gap-s.norm;
                    Text {
                        text: "Pins";
                        font-size: Theme.font-s.mid;
                        color: Theme.fg-c.page;
                        font-weight: 900;
                    }
                }
            }

            VerticalLayout {
                spacing: Theme.gap-s.base;

                @children
            }
        }
    }
}
