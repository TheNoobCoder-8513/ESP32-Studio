import { Panel, VL, HL, Check-Button } from "../../widget.slint";
import { Theme } from "../../../theme.slint";



export struct Track-Pin { 
    gpio: int,
    data: [float],
}



export component Track-Pin-Selector inherits VL {
    pure callback toggle-track-pin(int);

    padding: 0px;

    Panel {
        HL {
            padding: Theme.gap-s.norm;
            Text {
                text: "Pins";
                font-size: Theme.font-s.mid;
                color: Theme.fg-c.page;
                font-weight: 900;
            }
        }
    }

    Flickable {
        width: 200px;

        VerticalLayout {
            private property <[{ title: string, gpio: int, enabled: bool }]> pins: [
                { title: "3V3", gpio: -1, enabled: false },
                { title: "EN", gpio: -1, enabled: false },
                { title: "SENSOR_VP", gpio: 36, enabled: true },
                { title: "SENSOR_VN", gpio: 39, enabled: true },
                { title: "D34", gpio: 34, enabled: true },
                { title: "D35", gpio: 35, enabled: true },
                { title: "D32", gpio: 32, enabled: true },
                { title: "D33", gpio: 33, enabled: true },
                { title: "D25", gpio: 25, enabled: true },
                { title: "D26", gpio: 26, enabled: true },
                { title: "D27", gpio: 27, enabled: true },
                { title: "D14", gpio: 14, enabled: true },
                { title: "D12", gpio: 12, enabled: true },
                { title: "GND", gpio: -1, enabled: false },
                { title: "D13", gpio: 13, enabled: true },
                { title: "VIN", gpio: -1, enabled: false },
                { title: "GND", gpio: -1, enabled: false },
                { title: "D23", gpio: 23, enabled: true },
                { title: "D22", gpio: 22, enabled: true },
                { title: "TX2", gpio: 17, enabled: true },
                { title: "RX2", gpio: 16, enabled: true },
                { title: "D21", gpio: 21, enabled: true },
                { title: "D1", gpio: 1, enabled: false },
                { title: "D3", gpio: 3, enabled: false },
                { title: "D22_ALT", gpio: 22, enabled: true },
                { title: "D19", gpio: 19, enabled: true },
                { title: "D18", gpio: 18, enabled: true },
                { title: "D5", gpio: 5, enabled: true },
                { title: "D15", gpio: 15, enabled: true },
                { title: "D2", gpio: 2, enabled: true }
            ];

            for item[index] in pins: VerticalLayout {
                Panel {
                    HL {
                        padding-left: Theme.gap-s.norm;
                        padding-right: self.padding-left;

                        alignment: space-between;
                        spacing: Theme.gap-s.norm;

                        Text {
                            text: "Pin " + item.gpio;
                            font-size: Theme.font-s.mid;
                            color: Theme.fg-c.page;
                            overflow: elide;
                        }

                        Check-Button {
                            enabled: item.enabled;
                            toggled => {
                                root.toggle-track-pin(item.gpio);
                            }
                        }
                    }
                }

                if index != pins.length - 1: Rectangle {
                    height: Theme.gap-s.base;
                }
            }
        }
    }
}


export component Chart-Pin-Selector inherits VL {
    in-out property <int> active-chart;
    in property <[Track-Pin]> tracked-pins;

    padding: 0px;
    Panel {
        HL {
            padding: Theme.gap-s.norm;
            Text {
                text: "Tracked";
                horizontal-alignment: center;
                font-size: Theme.font-s.mid;
                color: Theme.fg-c.page;
                font-weight: 900;
            }
        }
    }

    Flickable {
        width: 100px;

        VerticalLayout {
            for item[index] in root.tracked-pins: VerticalLayout {
                height: 80px;
                Panel {

                    VL {
                        cross-axis-alignment: center;

                        Text {
                            text: item.data[item.data.length - 1] == 1 ? "HIGH" : "LOW";
                            font-size: Theme.font-s.mid;
                            color: Theme.fg-c.page;
                            font-weight: 900;
                        }

                        Text {
                            text: "Pin " + item.gpio;
                            font-size: Theme.font-s.norm;
                            color: Theme.fg-c.page;
                        }
                    }

                    touch := TouchArea {
                        clicked => {
                            root.active-chart = index;
                        }
                    }

                    states [
                        active when root.active-chart == index: {
                            border-color: Theme.accent;
                        }
                        hovered when touch.has-hover: {
                            border-color: Theme.bor-c.page;
                        }
                    ]
                }

                if index != root.tracked-pins.length - 1:Rectangle {
                    height: Theme.gap-s.base;
                }
            }
        }
    }
}
