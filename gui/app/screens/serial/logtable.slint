import { ListView } from "std-widgets.slint";
import { VL, HL, Panel } from "../../widget.slint";
import { Theme } from "../../theme.slint";

export struct LogItem-Data {
    date: string,
    time: string,
    log: string,
}

component LogHeader inherits Rectangle {
    in property <LogItem-Data> log;

    VerticalLayout {
        Panel {
            HL {
                spacing: Theme.gap-s.norm;
                padding-left: Theme.gap-s.norm;
                padding-right: self.padding-left;

                cross-axis-alignment: center;

                property <color> text-color: 
                     Theme.fg-c.base;

                Text {
                    width: 50px;
                    text: root.log.time;
                    font-size: Theme.font-s.mid;
                    color: parent.text-color;
                    font-weight: 900;
                }

                Text {
                    width: 100px;
                    text: root.log.date;
                    font-size: Theme.font-s.mid;
                    horizontal-alignment: center;
                    color: parent.text-color;
                    font-weight: 900;
                }

                Text {
                    text: root.log.log;
                    font-size: Theme.font-s.mid;
                    color: parent.text-color;
                    font-weight: 900;
                }
            }
        }
    }
}


component LogItem inherits Panel {
    in property <LogItem-Data> log;

    HL {
        spacing: Theme.gap-s.norm;
        padding-left: Theme.gap-s.norm;
        padding-right: self.padding-left;

        Text {
            width: 50px;
            text: root.log.time;
            font-size: Theme.font-s.norm;
            color: Theme.fg-c.surface;
        }

        Text {
            width: 100px;
            text: root.log.date;
            font-size: Theme.font-s.norm;
            horizontal-alignment: center;
            color: Theme.fg-c.surface;
        }

        Text {
            text: root.log.log;
            font-size: Theme.font-s.norm;
            color: Theme.fg-c.surface;
        }
    }
}

export component LogTable inherits Rectangle {
    in property <[LogItem-Data]> logs;
    property <LogItem-Data> column-headers: { date: "Date", time: "Time", log: "Log" };

    VL {
        padding: 0px;

        LogHeader {
            log: root.column-headers;
        }

        ListView {

            for elem[index] in logs: HorizontalLayout {
                LogItem {
                    log: elem;
                }

                if index != logs.length - 1: spacer := Rectangle {
                    height: Theme.gap-s.base;
                }
            }
        }
    }
}
