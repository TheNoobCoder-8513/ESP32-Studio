import { Theme } from "../../theme.slint";
import { Screen, Panel, HL, VL } from "../../widget.slint";
import { State } from "../../../state.slint";
import { Empty } from "emptyhome.slint";

export struct PinDef {
    labels: [string],
    gpio: int,
    enabled: bool,
}

export component PinState inherits Rectangle {
    height: 25px;
    width: self.height;
    border-radius: 5px;
    background: !root.enabled ? #2a2a32 : (root.selected ? Theme.bg.base : Theme.fg-c.base);

    in-out property <bool> enabled: true;
    in-out property <bool> selected: false;

    callback clicked(bool);

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.selected = !root.selected;
                root.clicked(root.selected);
            }
        }
    }

    Rectangle {
        x: 2px;
        y: self.x;
        height: root.height - self.x * 2;
        width: self.height;
        background: !root.enabled ? #18181f : Theme.bg.base;

        border-radius: 2px;

        states [
            disabled when !root.enabled: {
                background: #252530;
            }
            selected when root.selected: {
                background: #55ff60;
            }
        ]
    }
}

export component PinText inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;

    height: 20px;
    width: 80px;
    border-radius: 5px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: {
        if text.starts-with("GPIO") { #d261ff }
        else if text.starts-with("ADC") { #ff8851 }
        else if text.starts-with("Touch") { #87f458 }
        else { #74b5ff }
    }

    Text {
        text: root.text;
        font-size: 12px;
        color: Theme.bg.base;
        font-weight: 800;
    }
}

component RightPin inherits HL {
    in property <string> title;
    in-out property <bool> enabled: true;
    in-out property <bool> selected: false;

    callback clicked(bool);

    cross-axis-alignment: center;

    PinState {
        enabled: root.enabled;
        selected: root.selected;
        clicked(status) => {
            root.clicked(status);
        }
    }

    HL {
        spacing: 20px;
        alignment: start;
        @children
    }
}

component LeftPin inherits HL {
    in property <string> title;
    in-out property <bool> enabled: true;
    in-out property <bool> selected: false;

    callback clicked(bool);

    cross-axis-alignment: center;

    HL {
        spacing: 20px;
        alignment: end;
        @children
    }

    PinState {
        enabled: root.enabled;
        selected: root.selected;
        clicked(status) => {
            root.clicked(status);
        }
    }
}

component Esp32 {
    property <[PinDef]> left: [
        { labels: ["EN"], gpio: -1, enabled: false },
        { labels: ["SensVP", "ADC1_0", "GPIO36"], gpio: 36, enabled: false },
        { labels: ["SensVN", "ADC1_3", "GPIO39"], gpio: 39, enabled: false },
        { labels: ["ADC1_6", "GPIO34"], gpio: 34, enabled: false },
        { labels: ["ADC1_7", "GPIO35"], gpio: 35, enabled: false },
        { labels: ["XTAL32", "Touch9", "ADC1_4", "GPIO32"], gpio: 32, enabled: true },
        { labels: ["XTAL32", "Touch8", "ADC1_5", "GPIO33"], gpio: 33, enabled: true },
        { labels: ["DAC1", "ADC2_8", "GPIO25"], gpio: 25, enabled: true },
        { labels: ["DAC2", "ADC2_9", "GPIO26"], gpio: 26, enabled: true },
        { labels: ["Touch7", "ADC2_7", "GPIO27"], gpio: 27, enabled: true },
        { labels: ["HSPI_CLK", "Touch6", "ADC2_6", "GPIO14"], gpio: 14, enabled: true },
        { labels: ["HSPI_MISO", "Touch5", "ADC2_5", "GPIO12"], gpio: 12, enabled: true },
        { labels: ["HSPI_MOSI", "Touch4", "ADC2_4", "GPIO13"], gpio: 13, enabled: true },
        { labels: ["GND"], gpio: -1, enabled: false },
        { labels: ["VIN"], gpio: -1, enabled: false }
    ];

    property <[PinDef]> right: [
        { labels: ["GPIO23", "MOSI", "VSPI_MOSI"], gpio: 23, enabled: true },
        { labels: ["GPIO22", "SCL"], gpio: 22, enabled: true },
        { labels: ["GPIO1", "U0_TXD", "CLK3"], gpio: 1, enabled: true },
        { labels: ["GPIO3", "U0_RXD", "CLK2"], gpio: 3, enabled: true },
        { labels: ["GPIO21", "SDA"], gpio: 21, enabled: true },
        { labels: ["GPIO19", "MISO", "VSPI_MISO"], gpio: 19, enabled: true },
        { labels: ["GPIO18", "SCK", "VSPI_CLK"], gpio: 18, enabled: true },
        { labels: ["GPIO5", "VSPI_CS"], gpio: 5, enabled: true },
        { labels: ["GPIO17", "U2_TXD"], gpio: 17, enabled: true },
        { labels: ["GPIO16", "U2_RXD"], gpio: 16, enabled: true },
        { labels: ["GPIO4", "ADC2_0", "Touch0"], gpio: 4, enabled: true },
        { labels: ["GPIO2", "ADC2_2", "Touch2", "CS"], gpio: 2, enabled: true },
        { labels: ["GPIO15", "ADC2_3", "Touch3", "HSPI_CS"], gpio: 15, enabled: true },
        { labels: ["GND"], gpio: -1, enabled: false },
        { labels: ["3.3V"], gpio: -1, enabled: false }
    ];

    GridLayout {
        for row[index] in Math.max(left.length, right.length): Row {

            LeftPin {
                enabled: left[index].enabled;
                for item in left[index].labels: PinText {
                    text: item;
                    enabled: left[index].enabled;
                }

                clicked(status) => {
                    if (left[index].enabled && left[index].gpio >= 0) {
                        State.change-pin(left[index].gpio, status);
                    }
                }
            }

            Rectangle {
                width: 200px;
            }

            RightPin {
                enabled: right[index].enabled;
                for item in right[index].labels: PinText {
                    text: item;
                    enabled: right[index].enabled;
                }

                clicked(status) => {
                    if (right[index].enabled && right[index].gpio >= 0) {
                        State.change-pin(right[index].gpio, status);
                    }
                }
            }
        }
    }
}

export component Home inherits Rectangle {

    Panel {
        background: transparent;
        
        if State.connected: Esp32 { }

        if !State.connected: Empty {}
    }
}
