import { Serial-Tools, Connect-Tools, Toolbar } from "widget.slint";
import { State } from "../state.slint";
import { Logs-Tools } from "widgets/toolbar.slint";

export component Topbar inherits Toolbar {
    property <[string]> screens: ["Home", "Serial", "Track", "Logs", "Help", "Settings"];
    title: screens[State.active-screen];

    if State.active-screen == 1: Serial-Tools {
        export => {
            State.export(State.serial-logs);
        }
        clear => {
            State.clear-serial-logs();
        }
    }

    if State.active-screen == 3: Logs-Tools { 
        tele <=> State.tele;
        inserial <=> State.inserial;
        outserial <=> State.outserial;
        clear => {
            State.clear-all-logs();
        }
    }

    Connect-Tools {
        connected <=> State.connected;
        refresh => State.refresh-ports();
        connect(port, baud) => {
            State.connect(port, baud);
        }
        disconnect => {
            State.disconnect();
        }
    }
}
