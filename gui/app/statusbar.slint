import { Theme } from "../theme.slint";
import { Panel } from "widget.slint";
import { State } from "../state.slint";
import { State } from "../state.slint";


export component Statusbar inherits Panel {
    height: 32px;

    timer := Timer {
        interval: 5s;
        running: false;

        triggered => {
            State.tooltip = "Statusbar";
            timer.running = false;
            timer.stop();
        }
    }

    HorizontalLayout {
        padding-left: Theme.gap-s.base;
        padding-right: Theme.gap-s.base;
        alignment: space-between;

        Text {
            vertical-alignment: center;
            text: State.tooltip;
            font-size: 14px;
            color: Theme.fg-c.surface;

            changed text => {
                if (State.tooltip != "Statusbar") {
                    timer.running = true;
                    timer.restart();
                }
            }
        }

        Text {
            vertical-alignment: center;
            text: State.status-message;
            font-size: 18px;
            color: Theme.fg-c.surface;

            changed text => {
                if (State.tooltip != "") {
                    timer.running = true;
                    timer.restart();
                }
            }

            states [
                disconnected when self.text == "Disconnected": {
                    color: #bb1212;
                    font-weight: 900;
                }
                connected when self.text == "Connected": {
                    color: #19c233;
                    font-weight: 900;
                }
            ]
        }
    }
}
