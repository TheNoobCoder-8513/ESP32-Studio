import { Theme } from "../theme.slint";
import {
    Panel,
    Toolbar-Group,
    Icon-Button,
} from "widget.slint";
import { State } from "../state.slint";


export component Navbar {
    property <int> active <=> State.active-screen;

    width: 50px;

    VerticalLayout {
        spacing: Theme.gap-s.base;

        Toolbar-Group {
            Icon-Button {
                enabled: false;
                icon: @image-url("icons/stone.svg");
            }
        }

        property <[{ tooltip: string, icon: image }]> meta: [
            {
                tooltip: "Manage and preview the ESP in a glance",
                icon:@image-url("icons/house.svg")
            },
            { tooltip: "Logs the serial output from ESP", icon:@image-url("icons/tv.svg") },
            {
                tooltip: "Track the analog changes within ESP",
                icon:@image-url("icons/chart-no-axes-column.svg")
            },
            { tooltip: "View exported data", icon:@image-url("icons/logs.svg") },
            {
                tooltip: "Need some help ? Here it might be available.",
                icon:@image-url("icons/circle-question-mark.svg")
            }
        ];

        for elem[index] in meta: Toolbar-Group {
            Icon-Button {
                icon: elem.icon;
                accented: index == active;
                tooltip-enabled: true;
                enabled: {
                    // if index == 0 { true }
                    // else if (State.connected) { true } else { false }
                    true
                }
                hovered => {
                    State.tooltip = elem.tooltip;
                }
                clicked => {
                    // if (State.connected) {
                        root.active = index;
                    // }
                }
            }
        }

        Panel { }

        Toolbar-Group {
            Icon-Button {
                tooltip-enabled: true;
                tooltip: "Tweak application settings and preferences";
                icon: @image-url("icons/settings.svg");
                accented: active == 5;
                clicked => {
                    root.active = 5;
                }
            }
        }
    }
}
