import { Serial-Data } from "app/screens/serial/serialtable.slint";
import { Log-Data } from "app/screens/logs/logtable.slint";
import { Var-Data } from "app/screens/variable/track.slint";

export global Glue {

    // Home
    pure callback connect(string, string);
    pure callback disconnect();
    pure callback refresh-ports() -> [string];
    pure callback change-pin(int, bool);
    in-out property <bool> app-connected;

    // Serial
    pure callback clear-serial-output();
    pure callback export-serial-output([Serial-Data]);
    callback send-serial-input(string);
    in-out property <[Serial-Data]> serial-output: self.mock-serial-logs;

    // Logs
    pure callback clear-logs();
    in-out property <[Log-Data]> logs: self.mock-all-logs;

    // Variables Telemetry
    in-out property <[Var-Data]> variables: mock-var-data;

